<shell:AppBarWindow
    x:Class="Monitor.App.Views.SidebarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Monitor.App.Shell"
    xmlns:controls="clr-namespace:Monitor.App.Controls"
    Title="System Monitor"
    Width="340"
    Height="900"
    Background="{StaticResource SidebarBackgroundBrush}"
    TextElement.Foreground="{StaticResource SidebarForegroundBrush}">

    <shell:AppBarWindow.ContextMenu>
        <ContextMenu>
            <MenuItem Header="最前面表示" Click="OnTopmostMenuItemClick" IsCheckable="True" IsChecked="True" />
            <MenuItem Header="管理者で再起動" Click="OnRestartAsAdminMenuItemClick" />
            <MenuItem Header="幅をリセット" Click="OnResetWidthMenuItemClick" />
            <Separator />
            <MenuItem Header="終了" Click="OnExitMenuItemClick" />
        </ContextMenu>
    </shell:AppBarWindow.ContextMenu>

    <!-- スクロールバーは非表示。ホイールでのスクロールは有効なまま（Disabled にすると
         スクロール自体が止まり、画面に収まらないセクションが見られなくなるため）。 -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Grid.IsSharedSizeScope="True">

            <!-- ヘッダー -->
            <Grid Margin="12,8,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="System Monitor" Style="{StaticResource AppTitleStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding HeaderTime}" Style="{StaticResource SubTextStyle}" VerticalAlignment="Center" />
            </Grid>

            <!-- CPU -->
            <controls:SectionExpander SectionKey="cpu" SectionTitle="CPU" AccentBrush="{StaticResource CpuAccentBrush}"
                                       SectionSummary="{Binding CpuSummary}" IsExpanded="{Binding IsCpuExpanded}"
                                       Margin="12,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding CpuModelText}" Style="{StaticResource SubTextStyle}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource BigNumberStyle}" VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding CpuCurrentClockText}" Style="{StaticResource ValueTextStyle}"
                                   Margin="8,0,0,3" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <controls:GaugeBar Height="5" Value="{Binding CpuGaugeValue}"
                                        Foreground="{StaticResource CpuAccentBrush}" Margin="0,0,0,4" />
                    <controls:Sparkline Height="32" Values="{Binding CpuSparkline}" Minimum="0" Maximum="100"
                                         Stroke="{StaticResource CpuAccentBrush}" Fill="{StaticResource CpuFillBrush}"
                                         Margin="0,0,0,4" />
                    <controls:CoreGrid Height="30" Values="{Binding CpuCoreValues}"
                                        LowBrush="{StaticResource CpuFillBrush}" HighBrush="{StaticResource CpuAccentBrush}"
                                        Margin="0,0,0,3" />
                    <TextBlock Text="{Binding CpuCoreCountText}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4" />
                    <UniformGrid Columns="2">
                        <controls:StatRow Label="CPU 温度" Value="{Binding CpuTemperatureText}" Margin="0,0,6,0" />
                        <controls:StatRow Label="パッケージ電力" Value="{Binding CpuPowerText}" />
                    </UniformGrid>
                </StackPanel>
            </controls:SectionExpander>

            <!-- GPU -->
            <controls:SectionExpander SectionKey="gpu" SectionTitle="GPU" AccentBrush="{StaticResource GpuAccentBrush}"
                                       SectionSummary="{Binding GpuSummary}" IsExpanded="{Binding IsGpuExpanded}"
                                       Margin="12,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding GpuAdapterNameText}" Style="{StaticResource SubTextStyle}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding GpuUsageText}" Style="{StaticResource BigNumberStyle}" VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding GpuCoreClockText}" Style="{StaticResource ValueTextStyle}"
                                   Margin="8,0,0,3" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <controls:GaugeBar Height="5" Value="{Binding GpuGaugeValue}"
                                        Foreground="{StaticResource GpuAccentBrush}" Margin="0,0,0,4" />
                    <controls:Sparkline Height="32" Values="{Binding GpuSparkline}" Minimum="0" Maximum="100"
                                         Stroke="{StaticResource GpuAccentBrush}" Fill="{StaticResource GpuFillBrush}"
                                         Margin="0,0,0,4" />

                    <!-- エンジン別使用率: ラベル+バーを1行に（旧: ラベル上・バー下の2行）。 -->
                    <UniformGrid Columns="4" Margin="0,0,0,4">
                        <Grid Height="12" Margin="0,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="3D" Style="{StaticResource TinyLabelStyle}" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <controls:GaugeBar Grid.Column="1" Height="4" Value="{Binding Gpu3DValue}" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="12" Margin="4,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Copy" Style="{StaticResource TinyLabelStyle}" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <controls:GaugeBar Grid.Column="1" Height="4" Value="{Binding GpuCopyValue}" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="12" Margin="4,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Video" Style="{StaticResource TinyLabelStyle}" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <controls:GaugeBar Grid.Column="1" Height="4" Value="{Binding GpuVideoValue}" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="12" Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Compute" Style="{StaticResource TinyLabelStyle}" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <controls:GaugeBar Grid.Column="1" Height="4" Value="{Binding GpuComputeValue}" Foreground="{StaticResource GpuAccentBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <controls:StatRow Label="温度" Value="{Binding GpuTemperatureText}" Margin="0,0,6,0" />
                        <controls:StatRow Label="ホットスポット" Value="{Binding GpuHotspotTemperatureText}" />
                        <controls:StatRow Label="ファン" Value="{Binding GpuFanText}" Margin="0,0,6,0" />
                        <controls:StatRow Label="消費電力" Value="{Binding GpuPowerText}" />
                        <controls:StatRow Label="メモリクロック" Value="{Binding GpuMemoryClockText}" Margin="0,0,6,0" />
                    </UniformGrid>
                    <TextBlock Text="{Binding GpuVramText}" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,3" />
                    <controls:GaugeBar Height="5" Value="{Binding GpuVramGaugeValue}" Foreground="{StaticResource GpuAccentBrush}" Margin="0,0,0,4" />
                    <!-- ラベルはグラフに重ねて置く。独立した行にすると 1 行分（約 17px）を
                         ラベルだけに使うことになり、340px 幅では割に合わない。 -->
                    <Grid Height="24">
                        <controls:Sparkline Values="{Binding GpuTemperatureSparkline}" AutoScale="True"
                                             Stroke="{StaticResource GpuAccentBrush}" Fill="{StaticResource GpuFillBrush}" />
                        <TextBlock Text="GPU 温度" Style="{StaticResource TinyLabelStyle}"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" Opacity="0.75" />
                    </Grid>
                </StackPanel>
            </controls:SectionExpander>

            <!-- メモリ -->
            <controls:SectionExpander SectionKey="memory" SectionTitle="メモリ" AccentBrush="{StaticResource MemAccentBrush}"
                                       SectionSummary="{Binding MemorySummary}" IsExpanded="{Binding IsMemoryExpanded}"
                                       Margin="12,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding MemoryUsageText}" Style="{StaticResource BigNumberStyle}" VerticalAlignment="Bottom" />
                        <!-- 使用率は積み上げバーの「使用中」セグメントと同じ緑にして、
                             行を1つも足さずに凡例の役目を持たせる。 -->
                        <TextBlock Text="{Binding MemoryUsagePercentText}" Style="{StaticResource ValueTextStyle}"
                                   Foreground="{StaticResource MemAccentBrush}"
                                   Margin="8,0,0,3" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <!-- 積み上げバー（使用中[圧縮を重ね塗り] / 変更済み / スタンバイ / 空き） -->
                    <controls:StackedBar Height="12" Values="{Binding MemoryStackedValues}"
                                          OverlayValue="{Binding MemoryCompressedBytes}"
                                          SegmentBrushes="{StaticResource MemoryStackedBrushes}"
                                          OverlayBrush="{StaticResource MemCompressedBrush}"
                                          Margin="0,0,0,3" />
                    <controls:Sparkline Height="28" Values="{Binding MemorySparkline}" Minimum="0" Maximum="100"
                                         Stroke="{StaticResource MemAccentBrush}" Fill="{StaticResource MemFillBrush}"
                                         Margin="0,0,0,4" />

                    <!-- 上2行は積み上げバーのセグメントに対応する項目。ラベルをバーと同じ色にして
                         凡例を兼ねさせ、読み順（左上→右下）がバーの並び順（使用中→変更済み→
                         スタンバイ→空き）と一致するように並べている。
                         下2行はバーに対応しない項目なので既定のグレーのままにする。 -->
                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <controls:StatRow Label="圧縮済み" Value="{Binding MemoryCompressedText}"
                                          LabelBrush="{StaticResource MemCompressedLabelBrush}" Margin="0,0,6,0" />
                        <controls:StatRow Label="変更済み" Value="{Binding MemoryModifiedText}"
                                          LabelBrush="{StaticResource MemModifiedBrush}" />
                        <controls:StatRow Label="スタンバイ" Value="{Binding MemoryStandbyText}"
                                          LabelBrush="{StaticResource MemStandbyBrush}" Margin="0,0,6,0" />
                        <controls:StatRow Label="空き" Value="{Binding MemoryFreeText}"
                                          LabelBrush="{StaticResource MemFreeLabelBrush}" />
                        <controls:StatRow Label="キャッシュ" Value="{Binding MemoryCachedText}" Margin="0,0,6,0" />
                        <controls:StatRow Label="システムキャッシュ" Value="{Binding MemorySystemCacheText}" />
                        <controls:StatRow Label="ページプール" Value="{Binding MemoryPoolPagedText}" Margin="0,0,6,0" />
                        <controls:StatRow Label="非ページプール" Value="{Binding MemoryPoolNonPagedText}" />
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,3">
                        <controls:StatRow Label="コミット" Value="{Binding MemoryCommitText}" Margin="0,0,6,0" />
                        <controls:StatRow Label="コミットピーク" Value="{Binding MemoryCommitPeakText}" />
                    </UniformGrid>

                    <TextBlock Text="{Binding MemoryHardwareReservedText}" Style="{StaticResource TinyLabelStyle}" Margin="0,3,0,4"
                               Visibility="{Binding MemoryHasHardwareReserved, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- ページファイル: 1行（パス・使用率バー・使用率・使用量）。ピークはツールチップへ。 -->
                    <TextBlock Text="ページファイル" Style="{StaticResource TinyLabelStyle}" Margin="0,0,0,3" />
                    <ItemsControl ItemsSource="{Binding PageFileRows}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2" MinHeight="15" ToolTip="{Binding PeakText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PageFilePctCol" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PageFileUsageCol" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PathText}" Style="{StaticResource SubTextStyle}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <controls:GaugeBar Grid.Column="1" Height="5" Value="{Binding GaugeValue}"
                                                        Foreground="{StaticResource MemAccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource ProcessValueStyle}" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding UsageText}" Style="{StaticResource TinyLabelStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding MemoryHandlesLine}" Style="{StaticResource TinyLabelStyle}" Margin="0,0,0,4" />

                    <!-- スロット構成 -->
                    <TextBlock Text="{Binding MemorySlotSummaryText}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,3" />
                    <controls:SectionExpander SectionKey="memory-modules" SectionTitle="メモリモジュール"
                                               AccentBrush="{StaticResource MemAccentBrush}"
                                               SectionSummary="{Binding MemoryModulesSummary}"
                                               IsExpanded="{Binding IsMemoryModulesExpanded}">
                        <ItemsControl ItemsSource="{Binding MemoryModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0" MinHeight="15" ToolTip="{Binding PartNumberText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="DimmSlotCol" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="DimmCapCol" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="DimmSpeedCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SlotText}" Style="{StaticResource ProcessNameStyle}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding CapacityText}" Style="{StaticResource ProcessValueStyle}"
                                                   HorizontalAlignment="Left" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SpeedText}" Style="{StaticResource ProcessValueStyle}"
                                                   HorizontalAlignment="Left" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding ManufacturerText}" Style="{StaticResource SubTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SectionExpander>
                </StackPanel>
            </controls:SectionExpander>

            <!-- ストレージ（物理ディスク＋論理ドライブ統合。1ドライブ=1行） -->
            <controls:SectionExpander SectionKey="storage" SectionTitle="ストレージ" AccentBrush="{StaticResource DiskAccentBrush}"
                                       SectionSummary="{Binding StorageSummary}" IsExpanded="{Binding IsStorageExpanded}"
                                       Margin="12,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding DiskIoLineText}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,2" />
                    <!-- 読み込み・書き込みを1つのグラフに重ねる（Sparkline 自体は1系列描画なので2つ重ねる）。 -->
                    <Grid Height="28" Margin="0,0,0,4">
                        <controls:Sparkline Values="{Binding DiskReadSparkline}" AutoScale="True"
                                             Stroke="{StaticResource DiskAccentBrush}" Fill="{StaticResource DiskFillBrush}" />
                        <controls:Sparkline Values="{Binding DiskWriteSparkline}" AutoScale="True"
                                             Stroke="{StaticResource DiskWriteAccentBrush}" Fill="{StaticResource DiskWriteFillBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding StorageRows}" AlternationCount="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StorageRowStyle}" ToolTip="{Binding TooltipText}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <!-- SharedSizeGroup 無しの Auto だと行ごとに幅が変わり列がずれるため、
                                                 ネットワークアイコンが無い行でも幅を揃えられるよう固定幅にする。 -->
                                            <ColumnDefinition Width="13" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StorageLetterCol" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StoragePctCol" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StorageFreeCol" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StorageReadCol" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StorageWriteCol" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StorageTempCol" />
                                        </Grid.ColumnDefinitions>

                                        <!-- ネットワークドライブ用アイコン（ワイヤーフレーム地球儀。フォント絵文字は使わない） -->
                                        <Path Grid.Column="0"
                                              Data="M1,5 A4,4 0 1 0 9,5 A4,4 0 1 0 1,5 M1,5 A4,1.6 0 1 0 9,5 A4,1.6 0 1 0 1,5 M5,1 A1.6,4 0 1 0 5,9 A1.6,4 0 1 0 5,1"
                                              Width="9" Height="9" Stretch="Uniform" Stroke="{StaticResource SidebarSubTextBrush}"
                                              StrokeThickness="0.8" VerticalAlignment="Center"
                                              Visibility="{Binding IsNetwork, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DriveLetterText}" Style="{StaticResource ProcessNameStyle}"
                                                   FontWeight="SemiBold" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding LabelText}" Style="{StaticResource SubTextStyle}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <controls:GaugeBar Grid.Column="3" Height="5" Value="{Binding GaugeValue}"
                                                            Style="{StaticResource StorageGaugeBarStyle}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Visibility="{Binding HasCapacity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="4" Text="{Binding UsagePercentText}" Style="{StaticResource ProcessValueStyle}" Margin="0,0,6,0"
                                                   Visibility="{Binding HasCapacity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="5" Text="{Binding FreeText}" Style="{StaticResource ProcessValueStyle}" Margin="0,0,6,0"
                                                   Visibility="{Binding HasCapacity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="6" Text="{Binding ReadText}" Style="{StaticResource ProcessValueStyle}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="7" Text="{Binding WriteText}" Style="{StaticResource ProcessValueStyle}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="8" Text="{Binding TemperatureText}" Style="{StaticResource ProcessValueStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:SectionExpander>

            <!-- ネットワーク -->
            <controls:SectionExpander SectionKey="network" SectionTitle="ネットワーク" AccentBrush="{StaticResource NetAccentBrush}"
                                       SectionSummary="{Binding NetworkSummary}" IsExpanded="{Binding IsNetworkExpanded}"
                                       Margin="12,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding NetworkNicName}" Style="{StaticResource SubTextStyle}" Margin="0,0,0,3"
                               TextTrimming="CharacterEllipsis" />
                    <!-- 下り・上りを1行に並べ、グラフはストレージと同じく1つに重ねる。
                         色で系列を区別するので、値の文字色もグラフの線色に合わせる。 -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NetworkDownText}" Style="{StaticResource ValueTextStyle}"
                                   Foreground="{StaticResource NetAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding NetworkUpText}" Style="{StaticResource ValueTextStyle}"
                                   Foreground="{StaticResource NetUpAccentBrush}" />
                    </Grid>
                    <Grid Height="30" Margin="0,0,0,4">
                        <controls:Sparkline Values="{Binding NetworkDownSparkline}" AutoScale="True"
                                             Stroke="{StaticResource NetAccentBrush}" Fill="{StaticResource NetFillBrush}" />
                        <controls:Sparkline Values="{Binding NetworkUpSparkline}" AutoScale="True"
                                             Stroke="{StaticResource NetUpAccentBrush}" Fill="{StaticResource NetUpFillBrush}" />
                    </Grid>

                    <controls:SectionExpander SectionKey="network-all" SectionTitle="他のアダプタ"
                                               AccentBrush="{StaticResource NetAccentBrush}"
                                               SectionSummary="{Binding NetworkAllSummary}"
                                               IsExpanded="{Binding IsNetworkAllExpanded}">
                        <ItemsControl ItemsSource="{Binding NetworkAllRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,3">
                                        <TextBlock Text="{Binding NameText}" Style="{StaticResource SubTextStyle}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,1" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DownText}" Style="{StaticResource TinyLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding UpText}" Style="{StaticResource TinyLabelStyle}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SectionExpander>
                </StackPanel>
            </controls:SectionExpander>

            <!-- 温度・ファン -->
            <controls:SectionExpander SectionKey="thermal" SectionTitle="温度・ファン" AccentBrush="{StaticResource ThermalAccentBrush}"
                                       SectionSummary="{Binding ThermalSummary}" IsExpanded="{Binding IsThermalExpanded}"
                                       Margin="12,0,12,0">
                <StackPanel>

                    <!-- 管理者権限が無い場合 -->
                    <StackPanel Visibility="{Binding IsThermalElevated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="CPU・マザボ温度とファン RPM には管理者権限が必要"
                                   Style="{StaticResource ElevationHintStyle}" />
                        <Button Content="管理者で再起動" Style="{StaticResource ElevationButtonStyle}" Click="OnRestartAsAdminButtonClick" />
                    </StackPanel>

                    <!-- 管理者権限がある場合 -->
                    <StackPanel Visibility="{Binding IsThermalElevated, Converter={StaticResource BoolToVisibilityConverter}}">
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <controls:StatRow Label="CPU パッケージ" Value="{Binding ThermalCpuPackageText}" Margin="0,0,6,0" />
                            <controls:StatRow Label="CPU 電力" Value="{Binding ThermalCpuPowerText}" />
                            <controls:StatRow Label="マザーボード" Value="{Binding ThermalMotherboardText}" Margin="0,0,6,0" />
                            <controls:StatRow Label="VRM" Value="{Binding ThermalVrmText}" />
                        </UniformGrid>

                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="コア温度" Style="{StaticResource TinyLabelStyle}" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding ThermalCoreTemperatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1" MinHeight="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ProcessNameStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource ProcessValueStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="その他温度" Style="{StaticResource TinyLabelStyle}" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding ThermalOtherTemperatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1" MinHeight="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ProcessNameStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource ProcessValueStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="ファン" Style="{StaticResource TinyLabelStyle}" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding ThermalFans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1" MinHeight="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ProcessNameStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource ProcessValueStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:SectionExpander>

            <!-- プロセス -->
            <controls:SectionExpander SectionKey="process" SectionTitle="プロセス" AccentBrush="{StaticResource CpuAccentBrush}"
                                       SectionSummary="{Binding ProcessSummary}" IsExpanded="{Binding IsProcessExpanded}"
                                       Margin="12,0,12,12">
                <StackPanel>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CpuCol" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MemCol" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名前" Style="{StaticResource TinyLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="CPU%" Style="{StaticResource TinyLabelStyle}" Margin="8,0,0,0" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="メモリ" Style="{StaticResource TinyLabelStyle}" Margin="8,0,0,0" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CpuCol" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MemCol" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ProcessNameStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource ProcessValueStyle}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Style="{StaticResource ProcessValueStyle}" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:SectionExpander>

        </StackPanel>
    </ScrollViewer>

</shell:AppBarWindow>
