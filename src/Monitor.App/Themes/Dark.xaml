<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Monitor.App.Converters"
                    xmlns:controls="clr-namespace:Monitor.App.Controls"
                    xmlns:alerts="clr-namespace:Monitor.Core.Alerts;assembly=Monitor.Core">

    <!-- ===== コンバータ ===== -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <conv:AlertLevelToBrushConverter x:Key="AlertLevelToBrushConverter" />

    <!-- ===== ベースカラー ===== -->
    <!-- Acrylic/DWM backdrop の上に重ねる半透明背景。 -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#CC101014" />
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SidebarSubTextBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#22FFFFFF" />

    <!-- ===== セクションアクセントカラー ===== -->
    <SolidColorBrush x:Key="CpuAccentBrush" Color="#4EC9F5" />
    <SolidColorBrush x:Key="CpuFillBrush" Color="#3A4EC9F5" />
    <SolidColorBrush x:Key="GpuAccentBrush" Color="#9B7BF0" />
    <SolidColorBrush x:Key="GpuFillBrush" Color="#3A9B7BF0" />
    <SolidColorBrush x:Key="MemAccentBrush" Color="#5BD68A" />
    <SolidColorBrush x:Key="MemFillBrush" Color="#3A5BD68A" />
    <SolidColorBrush x:Key="DiskAccentBrush" Color="#F0A63A" />
    <SolidColorBrush x:Key="DiskFillBrush" Color="#3AF0A63A" />
    <!-- ストレージ合計 I/O グラフの書き込み系列（読み込みは DiskAccentBrush と重ねて描く）。 -->
    <SolidColorBrush x:Key="DiskWriteAccentBrush" Color="#F05A8C" />
    <SolidColorBrush x:Key="DiskWriteFillBrush" Color="#3AF05A8C" />
    <SolidColorBrush x:Key="NetAccentBrush" Color="#F05A8C" />
    <SolidColorBrush x:Key="NetFillBrush" Color="#3AF05A8C" />
    <!-- 上りは下りと同系色の明るいトーン。1つのグラフに重ねても区別できるようにする。 -->
    <SolidColorBrush x:Key="NetUpAccentBrush" Color="#F7A8C4" />
    <SolidColorBrush x:Key="NetUpFillBrush" Color="#30F7A8C4" />
    <SolidColorBrush x:Key="ThermalAccentBrush" Color="#E0623A" />
    <SolidColorBrush x:Key="ThermalFillBrush" Color="#3AE0623A" />

    <!-- 警告色。段階は 注意(Caution) / 危険(Critical) の2値（Monitor.Core.Alerts.AlertLevel 準拠）。
         旧 WarningBrush(#F05A8C) は DiskWriteAccentBrush と全く同じ色で「書き込み量」と「警告」が
         衝突していたため廃止し、以下の2色に分離する。
         注意 = 琥珀/金色系。既存の DiskAccentBrush(#F0A63A, Hue≈36°) と ThermalAccentBrush(#E0623A, Hue≈15°)
           がどちらも「燃えたオレンジ」寄りの色相なので、そこに埋没しないよう G 成分を大きく持ち上げて
           Hue≈45°の黄金色寄りにした。3px の細いアクセントバーでも「セクション本来のオレンジ」と
           「注意状態」が別の色だと分かる差になっている。
         危険 = 彩度の高い赤。DiskWriteAccentBrush/NetAccentBrush(#F05A8C, マゼンタ寄りピンク)とは
           B 成分を大きく下げることで明確に区別し、ThermalAccentBrush(#E0623A)とは G 成分の差で
           区別できる値にした。 -->
    <SolidColorBrush x:Key="AlertCautionBrush" Color="#F0C23C" />
    <SolidColorBrush x:Key="AlertCriticalBrush" Color="#F04A4A" />

    <!-- ===== メモリ積み上げバー（Task Manager の「メモリ構成」相当）用の色 ===== -->
    <SolidColorBrush x:Key="MemModifiedBrush" Color="#F0A63A" />
    <SolidColorBrush x:Key="MemStandbyBrush" Color="#4EC9F5" />
    <SolidColorBrush x:Key="MemFreeBrush" Color="#33FFFFFF" />
    <!-- 凡例としてラベルに使う色。バーの色をそのまま文字に流用できない 2 つだけ別に定義する。
         いずれもバー側の色は変えない（バーの見た目は現状で意図どおりのため）。
         空き: セグメントは 20% 白でコントラスト比 1.7:1 しかなく読めない。かといって
               中間グレーにすると既定のラベル色(#9AA0A6)と区別が付かず色分けの意味が消えるので、
               「白っぽいセグメント」と対応が取れるほぼ白にする。
         圧縮済み: セグメントの #2E8B57 は 10px では沈むので少しだけ明るくする。
               使用中(#5BD68A)より濃い緑、という関係は保つ。 -->
    <SolidColorBrush x:Key="MemFreeLabelBrush" Color="#E8EAEC" />
    <SolidColorBrush x:Key="MemCompressedLabelBrush" Color="#3FA873" />
    <!-- 「使用中」セグメントの内側に重ね塗りする圧縮済み分。使用中(MemAccentBrush)より濃い同系色。 -->
    <SolidColorBrush x:Key="MemCompressedBrush" Color="#2E8B57" />
    <!-- StackedBar.SegmentBrushes へそのまま渡す並び順: [使用中, 変更済み, スタンバイ, 空き]。 -->
    <x:Array x:Key="MemoryStackedBrushes" Type="{x:Type Brush}">
        <SolidColorBrush Color="#5BD68A" />
        <SolidColorBrush Color="#F0A63A" />
        <SolidColorBrush Color="#4EC9F5" />
        <SolidColorBrush Color="#33FFFFFF" />
    </x:Array>

    <!-- ===== フォント ===== -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- ===== テキストスタイル ===== -->
    <Style x:Key="AppTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SidebarForegroundBrush}" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SidebarSubTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- CPU/GPU セクション圧縮のため 20→15px に縮小。メモリ等の他セクションにも共通で効く
         （専用 Style へ分岐させず、全体で統一されたサイズにする）。 -->
    <Style x:Key="BigNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource SidebarForegroundBrush}" />
    </Style>

    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SidebarForegroundBrush}" />
    </Style>

    <Style x:Key="UnitStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SidebarSubTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="4,0,0,4" />
    </Style>

    <Style x:Key="SubTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SidebarSubTextBrush}" />
    </Style>

    <Style x:Key="TinyLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource SidebarSubTextBrush}" />
    </Style>

    <Style x:Key="ProcessNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SidebarForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProcessValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SidebarSubTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ストレージのボリューム/ネットワーク行の使用率・使用量。通常時は BasedOn 元の
         ProcessValueStyle（SidebarSubTextBrush）を使い、AlertLevel がある場合だけテーマの
         警告色で上書きする。Foreground へ直接バインドしないため、正常値がローカル値として
         スタイルの既定色を覆い隠すことはない。 -->
    <Style x:Key="StorageVolumeValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ProcessValueStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static alerts:AlertLevel.Caution}">
                <Setter Property="Foreground" Value="{StaticResource AlertCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static alerts:AlertLevel.Critical}">
                <Setter Property="Foreground" Value="{StaticResource AlertCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource SidebarSubTextBrush}" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SidebarForegroundBrush}" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- ===== 管理者権限が必要な項目向けの案内/ボタン ===== -->
    <Style x:Key="ElevationHintStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SidebarSubTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ElevationButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SidebarForegroundBrush}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2FFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 区切り線 ===== -->
    <Style x:Key="DividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource SidebarDividerBrush}" />
        <Setter Property="Margin" Value="16,4,16,4" />
    </Style>

    <!-- ===== ストレージ一覧の使用率バー =====
         StorageRowViewModel.AlertLevel（Monitor.Core.Alerts.AlertEvaluator.DriveCapacity /
         NetworkDriveDisconnected 由来）に応じて、注意と危険で色を分ける。 -->
    <Style x:Key="StorageGaugeBarStyle" TargetType="controls:GaugeBar">
        <Setter Property="Foreground" Value="{StaticResource DiskAccentBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static alerts:AlertLevel.Caution}">
                <Setter Property="Foreground" Value="{StaticResource AlertCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static alerts:AlertLevel.Critical}">
                <Setter Property="Foreground" Value="{StaticResource AlertCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ストレージ一覧のボリューム/ネットワーク行。物理ディスクごとのグループ化で見出し行
         (StorageDiskHeaderStyle) がグループの頭を示すようになったため、旧来の AlternationCount による
         縞模様（見出し行が混ざると意味をなさない）は廃止した。未準備（IsReady=False）のドライブは薄く表示する。 -->
    <Style x:Key="StorageRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="15" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsReady}" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ストレージ一覧の物理ディスク見出し行。ごく薄い背景（縞背景と同じ #08FFFFFF）でグループの頭を示す。
         上に3px マージンを空けてグループ間の区切りにする（最初のグループの上に空いても実害は無いため
         先頭だけ特別扱いはしていない）。
         警告時（Caution / Critical）は行の背景を警告色ではっきり塗る。DropShadowEffect によるグローは
         環境（GPU/RDP等）によってはほぼ見えないことがあるため補助的な位置づけとし、視認性の主役は
         不透明度の高い背景色と、BusyPercentText 自体の文字色（AlertLevelToBrushConverter 経由）にした。 -->
    <Style x:Key="StorageDiskHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="#08FFFFFF" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Padding" Value="0,1,0,2" />
        <Setter Property="MinHeight" Value="16" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static alerts:AlertLevel.Caution}">
                <Setter Property="Background" Value="#70F0C23C" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.90" Color="#F0C23C" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static alerts:AlertLevel.Critical}">
                <Setter Property="Background" Value="#90F04A4A" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="1.0" Color="#F04A4A" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== SectionExpander ===== -->
    <SolidColorBrush x:Key="SectionHeaderHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ChevronBrush" Color="#9AA0A6" />

    <Style x:Key="SectionSummaryStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource SidebarSubTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ===== StatRow: ラベル+値の統計行を1行に収める既定スタイル ===== -->
    <Style TargetType="{x:Type controls:StatRow}">
        <Setter Property="ValueBrush" Value="{StaticResource SidebarForegroundBrush}" />
        <Setter Property="LabelBrush" Value="{StaticResource SidebarSubTextBrush}" />
        <Setter Property="MinHeight" Value="15" />
        <Setter Property="Padding" Value="0,0,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatRow}">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{TemplateBinding Label}"
                                       FontFamily="{StaticResource DisplayFontFamily}" FontSize="10"
                                       Foreground="{TemplateBinding LabelBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Value}"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                       Foreground="{TemplateBinding ValueBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
